# Postgres (matches docker-compose.yml defaults). asyncpg driver.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vambora

# SPPO real-time endpoint (RJ-SMTR). Confirmed live on 2026-05-08.
# Filters by datahoraenvio (server arrival), not datahora. ISO date format only.
SPPO_URL=https://dados.mobilidade.rio/gps/sppo

# Polling cadence in seconds. Plan target: 30s.
POLL_INTERVAL_SECONDS=30

# Window padding: each tick fetches [now - WINDOW_SECONDS, now] in BRT.
# Slightly larger than POLL_INTERVAL to tolerate clock skew and slow ticks.
WINDOW_SECONDS=45

# uvicorn
HTTP_HOST=0.0.0.0
HTTP_PORT=8001

LOG_LEVEL=INFO
