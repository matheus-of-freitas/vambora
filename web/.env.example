# Backend API base URL (no trailing slash). Defaults to local backend on port 8002.
# In a deploy this is the API's public URL — with the domain deferred that's the
# sslip.io hostname, e.g. https://api-<vm-ip>.sslip.io
NEXT_PUBLIC_API_BASE_URL=http://localhost:8002

# MapLibre style. Leave unset to use the bundled free Carto raster style (no key
# required, fine for dev). For production set a MapTiler style URL (Path A):
#   NEXT_PUBLIC_MAP_STYLE=https://api.maptiler.com/maps/dataviz-dark/style.json?key=YOUR_KEY
# (Path B — self-hosted Protomaps on Cloudflare R2 — is deferred.)
# NEXT_PUBLIC_MAP_STYLE=

# Deploy note: for the Cloudflare Pages build, set NEXT_PUBLIC_API_BASE_URL and
# NEXT_PUBLIC_MAP_STYLE as Pages **environment variables** (the MapTiler key
# lives there + in your local .env.local, never committed). See
# docs/operations/* and plan.md "Appendix: Deployment (domain-deferred)".
