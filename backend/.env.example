# Postgres (asyncpg driver). Matches docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vambora
# Sync URL used by Alembic only.
DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5432/vambora

# Redis — present in docker-compose for Phase 0 readiness; not used by the
# current ingestion path, will be wired in once event bus is added.
REDIS_URL=redis://localhost:6379/0

# SPPO (RJ-SMTR) real-time bus position feed.
SPPO_URL=https://dados.mobilidade.rio/gps/sppo
SPPO_POLL_INTERVAL_SECONDS=30
SPPO_WINDOW_SECONDS=45

# Static GTFS feed. Official endpoint
# (http://dadosabertos2.rio.rj.gov.br/dadoaberto/google-transit/google_transit.zip)
# is broken as of 2026-05-09; we use the TUMI Datahub mirror, last updated
# 2024-04-29. See plan.md "Appendix: GTFS Quirks" for the open question on
# obtaining a fresher feed for production.
GTFS_URL=https://hub.tumidata.org/dataset/d0978152-4bbc-4162-810b-7478c9f2b0f7/resource/f1b70820-9c4a-4295-bc98-c9beb04ba457/download/rdj.zip

# Project arrivals queries against a date that's actually inside the feed's
# calendar window (currently 2023-06-11 to 2025-05-31). Without this, today's
# date returns empty for /stops/{id}/arrivals. Drop once a fresher feed lands.
# GTFS_DATE_OVERRIDE=2024-05-08

# OpenTripPlanner v2 (docker-compose service `otp`). The trip planner posts
# to ${OTP_URL}/otp/gtfs/v1. Default works for local docker-compose.
OTP_URL=http://localhost:8080

# Transfers with less slack than this (seconds) are flagged "apertada" in the
# planner. Rio's GTFS has no transfers.txt (no timed/guaranteed transfers),
# so this derived slack is the honest connection-reliability signal.
# ROUTING_TIGHT_TRANSFER_SECONDS=180

# Naive ETA tuning (plan.md decision #7). Defaults are sane; override only to
# experiment. ETA_FRESH_SECONDS gates vehicle liveness on received_at;
# ETA_FALLBACK_KMH floors speed so a stopped bus still has an ETA;
# ETA_MAX_SNAP_M is how far off a route shape a vehicle may sit.
# ETA_FRESH_SECONDS=180
# ETA_FALLBACK_KMH=15.0
# ETA_MAX_HORIZON_SECONDS=3600
# ETA_MAX_SNAP_M=150.0

# Alert evaluation (plan.md decision #4). Defaults are sane; the evaluator
# loop runs every interval, cooldown stops a rule re-firing while a bus
# dwells within threshold. Reuses ETA_* for the prediction query.
# ALERT_EVAL_INTERVAL_SECONDS=30
# ALERT_COOLDOWN_SECONDS=600

# uvicorn
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

LOG_LEVEL=INFO
# "local" allows any CORS origin. For a deploy set this to anything else
# (e.g. "production") AND set CORS_ALLOW_ORIGINS below, or the browser web
# app cannot call the API.
ENVIRONMENT=local

# Only used when ENVIRONMENT != "local". Comma-separated browser origins
# allowed via CORS. No domain needed — use the Cloudflare Pages URL, e.g.:
#   CORS_ALLOW_ORIGINS=https://vambora-web.pages.dev
# See plan.md "Appendix: Deployment (domain-deferred)".
CORS_ALLOW_ORIGINS=
